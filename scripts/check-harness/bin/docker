#!/bin/sh
# Harness shim: prints recorded `docker` output and never talks to a daemon.
# Output depends on the arguments the way the real CLI's would: `ps` answers
# only for the compose project `shop`, and every --format call prints the
# recorded tab-separated fields. `docker inspect` without --format, or with a
# format that reads the environment, prints the full JSON with canary secrets
# in Config.Env, as a real one would, so the harness fails if a check asks
# for more than named fields.
out=${HARNESS_OUT:-/opt/daminus-harness/out}/docker
cmd=${1-}
[ "$#" -gt 0 ] && shift
format=""
filter=""
while [ "$#" -gt 0 ]; do
	case $1 in
	--format | -f)
		format=${2-}
		shift
		;;
	--format=*) format=${1#--format=} ;;
	--filter)
		filter="$filter ${2-}"
		shift
		;;
	esac
	shift
done
case $cmd in
version) cat "$out/version.txt" ;;
system) cat "$out/system-df.tsv" ;;
ps)
	case $filter in
	*label=com.docker.compose.project=shop*) cat "$out/ps-shop.txt" ;;
	esac
	;;
inspect)
	case $format in
	'' | *Env*) cat "$out/inspect.json" ;;
	*) cat "$out/inspect.tsv" ;;
	esac
	;;
stats) cat "$out/stats.tsv" ;;
compose) cat "$out/compose-config.yml" ;;
*) exit 1 ;;
esac
