#!/bin/sh
# Harness shim: answers like psql for the db.size query. The real client
# reads its login from the environment (PGUSER, PGPASSWORD, PGHOST, PGPORT),
# so this one exits 1, like a refused login, unless that holds what the
# harness DATABASE_URL names.
out=${HARNESS_OUT:-/opt/daminus-harness/out}/db
[ "${PGUSER-}" = analytics ] || exit 1
[ "${PGPASSWORD-}" = CANARY_dotenv_pg_url_3d7e ] || exit 1
[ "${PGHOST-}" = 10.0.0.5 ] && [ "${PGPORT-}" = 5432 ] || exit 1
case " $* " in
*' -W '* | *' -U '* | *' -h '*) exit 1 ;;
esac
cat "$out/psql.tsv"
