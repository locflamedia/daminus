#!/bin/sh
# Harness shim: prints a recorded kernel log with two OOM kills, stamped
# within the last day of this machine's uptime (real dmesg needs CAP_SYSLOG
# or dmesg_restrict=0, which differ between CI and a laptop).
read -r up _ </proc/uptime
up=${up%.*}
t=$((up > 600 ? up - 600 : 1))
printf '[%d.000000] Out of memory: Killed process 4121 (php-fpm8.3) total-vm:812344kB, anon-rss:523412kB\n' "$t"
printf '[%d.000000] oom-kill:constraint=CONSTRAINT_MEMCG,task=node,pid=5230,uid=1000\n' "$((t + 1))"
printf '[%d.000000] Memory cgroup out of memory: Killed process 5230 (node) total-vm:1204112kB\n' "$((t + 2))"
printf '[%d.000000] eth0: link up\n' "$((t + 3))"
