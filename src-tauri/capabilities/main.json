{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the app's own commands, scan events, dragging and zooming by the title strip, https links and writing to the clipboard. No shell, file system or HTTP plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-scan-start",
    "allow-scan-stop",
    "allow-scan-status",
    "allow-report-latest",
    "allow-projects-list",
    "allow-reveal-config-dir",
    "allow-reveal-ssh-dir",
    "allow-hosts-list",
    "allow-ssh-environment",
    "allow-setup-start",
    "allow-setup-stop",
    "allow-setup-status",
    "allow-setup-result",
    "allow-projects-validate",
    "allow-projects-save",
    "allow-projects-remove",
    "allow-url-check",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-fullscreen",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "clipboard-manager:allow-write-text"
  ]
}
