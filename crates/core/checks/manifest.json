{
  "checks": [
    {
      "id": "sys.load",
      "group": "system",
      "runs": "remote",
      "script": "sys_load.sh",
      "needs": ["nproc", "getconf"],
      "facts": {
        "target": "empty: one result per host",
        "value": "5-minute load average",
        "unit": "load",
        "data": {
          "cores": "online CPUs (nproc)",
          "load1": "1-minute load average",
          "load15": "15-minute load average"
        }
      },
      "rule": {
        "type": "threshold",
        "field": "value",
        "warn": 1.0,
        "crit": 2.0,
        "cmp": "gt",
        "scale": "cores"
      }
    },
    {
      "id": "sys.mem",
      "group": "system",
      "runs": "remote",
      "script": "sys_mem.sh",
      "needs": ["awk"],
      "facts": {
        "target": "empty: one result per host",
        "value": "memory available to programs, % of total (MemAvailable)",
        "unit": "%",
        "data": {
          "total": "MemTotal in bytes",
          "available": "MemAvailable in bytes (MemFree + Buffers + Cached on kernels before 3.14)"
        }
      },
      "rule": {
        "type": "threshold",
        "field": "value",
        "warn": 15.0,
        "crit": 5.0,
        "cmp": "lt"
      }
    },
    {
      "id": "sys.swap",
      "group": "system",
      "runs": "remote",
      "script": "sys_swap.sh",
      "needs": ["awk"],
      "facts": {
        "target": "empty: one result per host",
        "value": "swap in use, % of total; 0 without swap",
        "unit": "%",
        "data": {
          "total": "SwapTotal in bytes (0: no swap)",
          "used": "swap used in bytes"
        }
      },
      "rule": {
        "type": "threshold",
        "field": "value",
        "warn": 50.0,
        "crit": 80.0,
        "cmp": "gt"
      }
    },
    {
      "id": "sys.psi",
      "group": "system",
      "runs": "remote",
      "script": "sys_psi.sh",
      "needs": ["awk"],
      "facts": {
        "target": "empty: one result per host",
        "data": {
          "cpu": "% of the last minute some tasks waited for CPU (some avg60)",
          "memory": "same for memory",
          "io": "same for IO"
        }
      },
      "rule": {
        "type": "max_of",
        "rules": [
          {
            "type": "threshold",
            "field": "data.cpu",
            "warn": 10.0,
            "crit": 25.0,
            "cmp": "gt"
          },
          {
            "type": "threshold",
            "field": "data.memory",
            "warn": 10.0,
            "crit": 25.0,
            "cmp": "gt"
          },
          {
            "type": "threshold",
            "field": "data.io",
            "warn": 10.0,
            "crit": 25.0,
            "cmp": "gt"
          }
        ]
      }
    },
    {
      "id": "sys.oom",
      "group": "system",
      "runs": "remote",
      "script": "sys_oom.sh",
      "needs": ["id", "journalctl", "dmesg", "awk"],
      "facts": {
        "target": "empty: one result per host",
        "value": "processes the kernel killed for lack of memory in the last 24 hours",
        "unit": "count",
        "data": {
          "procs": "names of the killed processes, at most 10 distinct"
        }
      },
      "rule": {
        "type": "threshold",
        "field": "value",
        "warn": 1.0,
        "crit": 5.0,
        "cmp": "gte"
      }
    },
    {
      "id": "disk.fs",
      "group": "disk",
      "runs": "remote",
      "script": "disk_fs.sh",
      "needs": ["df", "awk"],
      "facts": {
        "target": "mount point of a local, device-backed filesystem (each device once)",
        "data": {
          "pct": "space used, % (df Capacity)",
          "ipct": "inodes used, %; 0 when the filesystem has no fixed inode table",
          "size": "size in bytes",
          "used": "used bytes",
          "avail": "bytes available to non-root users",
          "fs": "filesystem type"
        }
      },
      "rule": {
        "type": "max_of",
        "rules": [
          {
            "type": "threshold",
            "field": "data.pct",
            "warn": 80.0,
            "crit": 90.0,
            "cmp": "gte"
          },
          {
            "type": "threshold",
            "field": "data.ipct",
            "warn": 80.0,
            "crit": 90.0,
            "cmp": "gte"
          }
        ]
      }
    },
    {
      "id": "logs.big",
      "group": "disk",
      "runs": "remote",
      "script": "logs_big.sh",
      "needs": ["find"],
      "facts": {
        "target": "path of a log file over 500 MiB in /var/log, /var/lib/docker/containers or <project folder>/storage/logs; empty with value 0 when none; a folder the SSH user cannot enter (needs_perm)",
        "value": "file size",
        "unit": "bytes",
        "data": {
          "mtime": "last change, unix seconds"
        }
      },
      "rule": {
        "type": "present",
        "severity": "warn"
      }
    },
    {
      "id": "disk.path",
      "group": "disk",
      "runs": "remote",
      "script": "disk_path.sh",
      "needs": ["du", "find", "awk"],
      "facts": {
        "target": "a project folder on this host (path component)",
        "value": "disk usage of the folder without skip paths (du -x)",
        "unit": "bytes",
        "data": {
          "top": "five largest subfolders, [name, bytes]",
          "other": "bytes outside the five",
          "files": "largest files over the Settings floor (DAMINUS_LARGE_FILE_MB), [relative path, bytes], at most 10",
          "partial": "true when du could not read every subfolder"
        }
      },
      "rule": {
        "type": "info"
      }
    },
    {
      "id": "docker.df",
      "group": "containers",
      "runs": "remote",
      "script": "docker_df.sh",
      "needs": ["docker", "awk"],
      "facts": {
        "target": "empty: one result per host; no result without docker",
        "value": "total size of images, containers, volumes and build cache",
        "unit": "bytes",
        "data": {
          "images": "{count, active, size, reclaimable} (bytes)",
          "containers": "same",
          "volumes": "same (local volumes)",
          "build_cache": "same"
        }
      },
      "rule": {
        "type": "info"
      }
    },
    {
      "id": "docker.compose",
      "group": "containers",
      "runs": "remote",
      "script": "docker_compose.sh",
      "needs": ["docker", "awk"],
      "facts": {
        "target": "compose project name (label com.docker.compose.project)",
        "data": {
          "containers": "containers of the project, one-off runs excluded (0: none left, the project is down)",
          "running": "containers running",
          "not_running": "containers not running, except ones that exited 0 with restart policy 'no'",
          "restarts": "restart count, summed",
          "mem_pct": "highest container memory use, % of its limit, or of host memory for a container without a limit (docker stats MemPerc)",
          "services": "per container {name, svc (compose service), state, restarts, mem (bytes), limit (bytes, 0: none), cpu (%), oom, exit, started, image}"
        }
      },
      "rule": {
        "type": "max_of",
        "rules": [
          {
            "type": "threshold",
            "field": "data.containers",
            "warn": 0.0,
            "crit": 0.0,
            "cmp": "lte"
          },
          {
            "type": "threshold",
            "field": "data.not_running",
            "warn": 0.0,
            "crit": 0.0,
            "cmp": "gt"
          },
          {
            "type": "threshold",
            "field": "data.restarts",
            "warn": 0.0,
            "cmp": "gt"
          },
          {
            "type": "threshold",
            "field": "data.mem_pct",
            "warn": 90.0,
            "cmp": "gte"
          }
        ]
      }
    },
    {
      "id": "pm2.app",
      "group": "containers",
      "runs": "remote",
      "script": "pm2_app.sh",
      "needs": ["pm2", "awk"],
      "facts": {
        "target": "pm2 app name",
        "data": {
          "status": "worst instance status (online, stopped, errored…); 'stopped' when the daemon does not run",
          "daemon": "whether the pm2 daemon of this PM2_HOME runs",
          "instances": "processes with this name (cluster mode)",
          "restarts": "restart_time, summed",
          "mem_mb": "memory of all instances, MB",
          "started": "latest instance start, unix seconds",
          "ids": "pm_id of each instance"
        }
      },
      "rule": {
        "type": "max_of",
        "rules": [
          {
            "type": "state_map",
            "field": "data.status",
            "map": {
              "online": "ok",
              "stopped": "crit",
              "errored": "crit"
            },
            "default": "warn"
          },
          {
            "type": "increase",
            "field": "data.restarts",
            "severity": "warn",
            "min": 2.0
          }
        ]
      }
    },
    {
      "id": "db.size",
      "group": "databases",
      "runs": "remote",
      "script": "db_size.sh",
      "needs": ["mysql", "psql", "docker", "awk", "sed", "tr"],
      "facts": {
        "target": "database name (database component)",
        "value": "size of the database (MySQL: data + index length from information_schema, cached by the server for up to 24 h; Postgres: pg_database_size). With a container set on the component the server inside it is asked, whatever host and port the .env holds",
        "unit": "bytes",
        "data": {
          "engine": "mysql or postgres",
          "tables": "number of tables",
          "top": "five largest tables, [name, bytes]",
          "other": "bytes outside the five"
        }
      },
      "rule": {
        "type": "info"
      }
    },
    {
      "id": "sec.miner",
      "group": "security",
      "runs": "remote",
      "rule": {
        "type": "present",
        "severity": "crit"
      }
    },
    {
      "id": "sec.upload_php",
      "group": "security",
      "runs": "remote",
      "rule": {
        "type": "present",
        "severity": "crit"
      }
    },
    {
      "id": "sec.tmp_exec",
      "group": "security",
      "runs": "remote",
      "rule": {
        "type": "present",
        "severity": "warn"
      }
    },
    {
      "id": "sec.preload",
      "group": "security",
      "runs": "remote",
      "rule": {
        "type": "present",
        "severity": "crit"
      }
    },
    {
      "id": "sec.ports",
      "group": "security",
      "runs": "remote",
      "rule": {
        "type": "present",
        "severity": "warn"
      }
    },
    {
      "id": "sec.recent_change",
      "group": "code_changes",
      "runs": "remote",
      "rule": {
        "type": "info"
      }
    },
    {
      "id": "url.http",
      "group": "uptime",
      "runs": "local",
      "rule": {
        "type": "max_of",
        "rules": [
          {
            "type": "state_map",
            "field": "data.class",
            "map": {
              "2xx": "ok",
              "3xx": "ok"
            },
            "default": "crit"
          },
          {
            "type": "threshold",
            "field": "value",
            "warn": 2000.0,
            "cmp": "gt"
          }
        ]
      }
    },
    {
      "id": "url.tls",
      "group": "uptime",
      "runs": "local",
      "rule": {
        "type": "days_left",
        "warn": 14.0,
        "crit": 3.0,
        "flags": ["expired", "untrusted", "mismatch"]
      }
    },
    {
      "id": "url.exposed",
      "group": "security",
      "runs": "local",
      "rule": {
        "type": "present",
        "severity": "crit"
      }
    }
  ]
}
